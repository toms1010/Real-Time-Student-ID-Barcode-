# ---------------------------------------------------------------------------
# Real-Time Student ID Barcode Detection System - environment template
#
# Copy to `.env` and adjust.  NEVER commit a real `.env` file.
#   cp .env.example .env
#
# All secrets are read from the environment only; no credentials are stored in
# source code or in the SQLite database.  The first administrator account is
# created by `scripts/setup.sh` (or `python -m app.cli create-admin`) using the
# password you type interactively - it is never stored in plaintext anywhere.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME="Student ID Barcode Detection System"
APP_ENV=development                 # development | testing | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                     # text | json

# --- Server -----------------------------------------------------------------
# Bind to loopback only.  Do not expose this service to a network.
API_HOST=127.0.0.1
API_PORT=8000
# Comma separated list of extra allowed CORS origins (blank = same-origin only)
CORS_ORIGINS=

# --- Database ---------------------------------------------------------------
DATABASE_URL="sqlite:///database/student_id_system.db"
DB_BUSY_TIMEOUT_MS=5000
DB_ENABLE_WAL=true

# --- Camera -----------------------------------------------------------------
CAMERA_DEVICE_INDEX=0                # 0 = first /dev/video* device
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720
CAMERA_FPS=30
CAMERA_SOURCE=                       # blank = device index; or file path; or rtsp:// URL

# --- Scanner ----------------------------------------------------------------
SCAN_COOLDOWN_MS=2000
CONFIDENCE_THRESHOLD=0.80
BARCODE_TIMEOUT_MS=3000
DETECT_ROI=true                      # draw / restrict to the scan region of interest

# --- Barcode policy ---------------------------------------------------------
# Barcode symbologies accepted for student lookup (see docs/architecture/decisions.md)
ALLOWED_BARCODE_FORMATS=Code128,Code39,EAN13,EAN8,UPCA,UPCE,ITF,QRCode,DataMatrix
BARCODE_PATTERN="^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"

# --- Audio feedback ---------------------------------------------------------
AUDIO_ENABLED=true
AUDIO_VOLUME=0.8
AUDIO_PLAYER=auto                    # auto | aplay | paplay | ffplay | none

# --- Security ---------------------------------------------------------------
# Signing secret for opaque session tokens.  Generate a fresh one per machine:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving it empty makes the server refuse to start with auth enabled.
SESSION_SECRET=
SESSION_TTL_MINUTES=720
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
MAX_UPLOAD_BYTES=2097152              # 2 MiB photo upload limit
ALLOWED_PHOTO_EXTENSIONS=.jpg,.jpeg,.png

# --- Reports ----------------------------------------------------------------
REPORT_TIMEZONE=Asia/Manila
REPORT_OUTPUT_DIR=exports
